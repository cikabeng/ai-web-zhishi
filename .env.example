# ============================================================
# 知实 AI (EduRAG) 环境变量模板
# 用法：复制为 .env 后按需填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。
# ============================================================

# ---------- 运行 ----------
APP_NAME=知实 AI
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
# 前端开发服务器地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 演示模式 ----------
# auto（默认）：没配大模型就自动进入演示模式
# on：强制演示模式（即使配了 Key，现场模型 API 故障时用这个兜底）
# off：强制模型模式
DEMO_MODE=auto

# ---------- 存储 ----------
# 相对路径一律相对于项目根目录
STORAGE_DIR=./storage
SQLITE_URL=sqlite:///./storage/app.db
CHROMA_DIR=./storage/chroma

# ---------- 上传限制 ----------
UPLOAD_MAX_MB=20
UPLOAD_MAX_PAGES=300
UPLOAD_ALLOWED_EXT=pdf,docx,txt,md

# ---------- 大模型（留空 = 自动进入演示模式）----------
# 任何 OpenAI 兼容服务均可：DeepSeek / 通义 / 智谱 / OpenAI / 本地 vLLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=60

# ---------- Embedding ----------
# api  = 调用远程向量模型（推荐，免装 torch）
# hash = 本地字面哈希向量（离线可用，仅作降级，语义能力弱）
# 留空时：配了 EMBED_API_KEY 就走 api，否则走 hash
EMBED_PROVIDER=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=bge-m3
EMBED_DIM=1024
EMBED_BATCH=16

# ---------- 截图报错分析 ----------
# auto     = 配了视觉模型就用视觉模型，否则用本地 rapidocr，都没有则不可用
# vision   = 强制走视觉模型（需要下面 VLM_* 三项）
# rapidocr = 强制走本地 OCR（离线可用）
# none     = 关闭识别，只保留手动粘贴入口
OCR_PROVIDER=auto
OCR_MAX_IMAGE_MB=8
# 超过这个长边会等比缩小后再识别
OCR_MAX_SIDE=1600
OCR_TIMEOUT=60

# 视觉模型（可选）：模型必须支持图像输入，例如 qwen-vl / glm-4v / gpt-4o
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# ---------- 检索 ----------
RETRIEVAL_TOP_K=6
# hash 向量建议 0.20，api 语义向量建议 0.30
RETRIEVAL_MIN_SCORE=0.30
MAX_CONTEXT_CHARS=6000

# ---------- 教学策略 ----------
GUIDED_REQUIRE_ATTEMPT=true
MAX_HINT_LEVEL=4
LEAK_GUARD_ENABLED=true
