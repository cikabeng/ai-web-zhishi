      <Box style={{ width: 275, border: '1px solid #D6DCE5', paddingLeft: 18, paddingRight: 18, paddingTop: 16, flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E4FA8' }}>分层教学引擎</Text>
        <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}>六类分类、L1–L4 逐级解锁、L3 提交门槛、安全护栏与反馈。</Text>
      </Box>
      <Box style={{ width: 275, border: '1px solid #D6DCE5', paddingLeft: 18, paddingRight: 18, paddingTop: 16, flexDirection: 'column', gap: 8 }}>
