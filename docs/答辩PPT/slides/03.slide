  <Box style={{ width: 1280, height: 581, paddingLeft: 60, paddingRight: 60, paddingTop: 24, paddingBottom: 18, flexDirection: 'column', gap: 16 }}>
    <Box style={{ width: 1160, height: 200, flexDirection: 'row', gap: 20 }}>
