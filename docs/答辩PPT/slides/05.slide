<Slide style={{ width: 1280, height: 720, padding: 0, background: '#FFFFFF', fontFamily: 'Source Han Sans SC, Microsoft YaHei, Arial, sans-serif' }}>
  <Box style={{ width: 1280, height: 68, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>技术选型：为什么自建链路、用离线向量</Text>
    <Text style={{ fontSize: 16, color: '#C9DBF5' }}>04 · AI STACK</Text>
  </Box>
  <Box style={{ width: 1280, height: 1, background: '#D6DCE5' }} />
  <Box style={{ width: 1280, height: 581, paddingLeft: 60, paddingRight: 60, paddingTop: 24, paddingBottom: 18, flexDirection: 'column', gap: 10 }}>
    <Box style={{ width: 1160, height: 44, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center' }}>
      <Box style={{ width: 210, paddingLeft: 14 }}><Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>技术点</Text></Box>
      <Box style={{ width: 630, paddingLeft: 14 }}><Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>选择与理由</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>放弃的方案</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 210, paddingLeft: 14 }}><Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>RAG 框架</Text></Box>
      <Box style={{ width: 630, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.4 }}>自建链路：引用绑定、层级约束、护栏需要精确控制，也便于逐项写测试</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.4 }}>LangChain：抽象层厚，定制更绕</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 210, paddingLeft: 14 }}><Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>向量表示</Text></Box>
      <Box style={{ width: 630, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.4 }}>512 维字符 n-gram 哈希：无 GPU、无外网、无 Key，评委零配置可复现</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.4 }}>语义 Embedding：需 Key 与网络</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 210, paddingLeft: 14 }}><Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>检索引擎</Text></Box>
      <Box style={{ width: 630, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.4 }}>Chroma 本地持久化：纯 Python、无需独立服务，集合带版本号便于升级</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.4 }}>Qdrant / 向量数据库：运维成本高</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 210, paddingLeft: 14 }}><Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>OCR</Text></Box>
      <Box style={{ width: 630, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.4 }}>rapidocr 本地离线为主，视觉模型为可选增强通道，四通道可切换</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.4 }}>纯云端 OCR：断网即不可用</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', alignItems: 'center' }}>
      <Box style={{ width: 210, paddingLeft: 14 }}><Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>混合打分</Text></Box>
      <Box style={{ width: 630, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.4 }}>0.75 向量相似 + 0.25 字面覆盖：兼顾主题相关与关键词精确匹配</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.4 }}>单一分数：易漏检或误召回</Text></Box>
    </Box>
  </Box>
</Slide>
